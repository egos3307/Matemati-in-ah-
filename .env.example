# ==============================================================================
# PROJE ENVIRONMENT VARIABLES (.env.example)
# Gerçek değerleri buraya yazmayın. Bu dosyayı kopyalayıp .env oluşturun.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERİTABANI (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Yeni ve boş Neon veritabanınızın PostgreSQL bağlantı dizesi
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. GÜVENLİK & AUTH
# ------------------------------------------------------------------------------
# Rastgele, güçlü en az 32 karakterlik JWT imzalama anahtarı
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Yönetici (HEAD_TEACHER) yetkisine otomatik yükseltilecek e-posta (isteğe bağlı)
ADMIN_EMAIL="admin@example.com"

# Öğrenci otomatik e-posta üretimi için varsayılan domain
DEFAULT_EMAIL_DOMAIN="student.internal"

# Yeni eklenen öğrenciler için varsayılan ilk şifre
DEFAULT_STUDENT_PASSWORD="ChangeMe123!"

# ------------------------------------------------------------------------------
# 3. LIVEKIT CANLI DERS SİSTEMİ
# ------------------------------------------------------------------------------
# LiveKit Cloud projesi veya kendi sunucunuzun WebSocket URL'si (wss://...)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"

# ------------------------------------------------------------------------------
# 4. GOOGLE DRIVE ENTEGRASYONU (Ders Kayıtları)
# ------------------------------------------------------------------------------
# OAuth2 yöntemi:
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Service Account yöntemi (Alternatif):
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Kayıtların yükleneceği Google Drive Klasör ID'si (Klasör linkindeki /folders/ID kısmı)
GOOGLE_DRIVE_FOLDER_ID=""

# ------------------------------------------------------------------------------
# 5. DOMAIN, VERCEL & CRON
# ------------------------------------------------------------------------------
# Frontend alan adı (CORS ve link paylaşımları için)
FRONTEND_URL="https://example.com"

# Vercel Cron tetikleme güvenliği için gizli anahtar
CRON_SECRET="your-secure-cron-secret-token"

# Uygulama adı (Jitsi oda ön eki, bildirimler ve AI promptları için)
APP_NAME="Matematik"

# ------------------------------------------------------------------------------
# 6. İLETİŞİM & WHATSAPP
# ------------------------------------------------------------------------------
# WhatsApp bildirim ve yönlendirme telefon numarası (Ülke kodu ile, örn: 905XXXXXXXXX)
WHATSAPP_PHONE=""
CONTACT_PHONE=""

# ------------------------------------------------------------------------------
# 7. YAPAY ZEKA VE SEO (İsteğe Bağlı)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GSC_SITE_URL="https://example.com"

# ------------------------------------------------------------------------------
# 8. BİLDİRİM VE MEDYA SERVİSLERİ (İsteğe Bağlı)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
NETGSM_HEADER=""
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""
YOUTUBE_CHANNEL_ID=""

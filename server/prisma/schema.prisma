generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
  PARENT
  HEAD_TEACHER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STUDENT)
  studentCode String? @unique // FMXXX formatında
  parentCode  String? @unique // FMVXXX formatında
  grade     String?  // Sınıf (5, 6, ..., 12)
  parentName String? // Veli Ad Soyad
  parentTel  String? // Veli Tel No
  studentTel String? // Öğrenci Tel No
  serviceProvided String? // Verilen Hizmet
  paymentStatus   String?  @default("UNPAID") // PAID, UNPAID, PARTIAL
  paymentDay      String?  // Ödeme günü
  paymentAmount   String?  // Aylık ücret
  paymentNote     String?  // Ödeme notları
  paymentType     String?  @default("MONTHLY") // MONTHLY, LESSON
  totalLessons    Int?     @default(0) // Toplam ders sayısı (derslik ödeme tipi için)

  // Öğrenci Kayıt Formu Ek Alanları
  birthDate         String?  // Doğum Tarihi
  schoolName        String?  // Okul Adı
  address           String?  // Adres
  preferredSchedule String?  // Tercih Edilen Gün ve Saat
  educationType     String?  // Online / Yüz yüze
  mathLevel         String?  // Matematik Seviyesi (Başlangıç / Orta / İleri)
  goalsNotes        String?  // Hedefler / Not Edilecek Özel Durumlar
  formDate          String?  // Form Kayıt Tarihi

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  teacherId Int?
  teacher   User?    @relation("TeacherStudents", fields: [teacherId], references: [id])
  students  User[]   @relation("TeacherStudents")

  lessons   Lesson[] @relation("TeacherLessons")
  lessonsAsStudent Lesson[] @relation("StudentLessons")
  homeworks StudentHomework[]
  trials    Trial[]
  blogPosts BlogPost[]
  hataDefteri HataDefteri[]
  classrooms Classroom[]
  pdfNotes   PdfNote[]
}

// Hesap + cihaz (IP) bazlı yanlış giriş kilidi: sadece deneme yapan cihaz kilitlenir
model LoginAttempt {
  id             Int       @id @default(autoincrement())
  key            String    @unique // `${userId}:${ip}`
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

model Trial {
  id        Int      @id @default(autoincrement())
  name      String
  type      String?  // LGS, TYT, AYT
  results   String   // JSON string: { "Türkçe": { "correct": 20, "wrong": 0, "empty": 0, "net": 20 }, ... }
  totalNet  Float
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())
}

model Lesson {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  date           DateTime
  zoomMeetingId  String?
  zoomJoinUrl    String?
  recordingUrl   String?
  recordingRequested Boolean @default(false)
  teacherId      Int
  teacher        User     @relation("TeacherLessons", fields: [teacherId], references: [id])
  studentId      Int?
  student        User?    @relation("StudentLessons", fields: [studentId], references: [id])
  studentIds     String?  // JSON array of student IDs for group lessons, e.g. "[1,2,3]"
  seriesId       String?  // Haftalık tekrarlayan ders serisi kimliği, aynı seriden gelen dersler için ortak
  homeworks      Homework[]
  createdAt      DateTime @default(now())
  deletedAt      DateTime?
}

model Homework {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  type        String   @default("HOMEWORK") // "HOMEWORK" or "QUESTION"
  imageUrl    String?  // base64 photo attached by teacher
  teacherId   Int?
  deadline    DateTime?
  lessonId    Int?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id])
  students    StudentHomework[]
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
}

model StudentHomework {
  id              Int      @id @default(autoincrement())
  studentId       Int
  student         User     @relation(fields: [studentId], references: [id])
  homeworkId      Int
  homework        Homework @relation(fields: [homeworkId], references: [id])
  status          String   @default("PENDING") // PENDING, COMPLETED
  submissionImage String?  // base64 photo uploaded by student
  submissionNote  String?  // optional note by student
  submittedAt     DateTime?
}

model BlogPost {
  id                Int      @id @default(autoincrement())
  title             String
  slug              String   @unique
  content           String
  excerpt           String
  coverImage        String?
  metaTitle         String?
  metaDescription   String?
  targetKeyword     String?
  secondaryKeywords String?
  faq               String?
  grade             String?
  topic             String?
  internalLinks     String?
  authorId          Int
  author            User     @relation(fields: [authorId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Camp {
  id           Int      @id @default(autoincrement())
  badge        String
  title        String
  subtitle     String
  image        String
  details      String   // JSON string: [{ icon, label, value }]
  description  String
  highlights   String   // JSON string: string[]
  price        String?
  whatsappLink String?
  category     String?  // Örn: "YKS 2027", "LGS 2027", "KPSS 2027", "MAARIF"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TrialLessonRequest {
  id            Int      @id @default(autoincrement())
  type          String   // "SELF" (Kendim için), "CHILD" (Çocuğum için)
  studentName   String   // Öğrenci Adı Soyadı
  email         String
  phone         String
  grade         String   // Sınıf
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  scheduledDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String
  message   String?
  createdAt DateTime @default(now())
}

model LessonChunk {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  index     Int
  data      Bytes
  createdAt DateTime @default(now())
}

model HataDefteri {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  imageData String   // base64 encoded image
  note      String?  // optional note/description
  createdAt DateTime @default(now())
}

model Classroom {
  id         Int      @id @default(autoincrement())
  name       String
  teacherId  Int
  teacher    User     @relation(fields: [teacherId], references: [id])
  studentIds String   // JSON array string: "[1, 2, 3]"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PdfNote {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String?  // LGS, YKS, KPSS, Genel vb.
  pdfUrl      String   // base64 or URL
  fileName    String?
  authorId    Int?
  author      User?    @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model QuotaCourse {
  id             Int      @id @default(autoincrement())
  category       String   // "YKS 2027", "LGS 2027", "KPSS 2027"
  title          String   // Örn: "TYT Matematik Canlı Kampı"
  description    String?
  published      Boolean  @default(true)
  tracks         String?  // JSON array string: '["Sayısal","Sözel","Eşit Ağırlık","Yabancı Dil"]'
  totalQuota     Int?     @default(20)
  remainingQuota Int?     @default(5)
  price          String?  // Örn: "3.500 TL"
  image          String?
  whatsappLink   String?
  teacherId      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  applications   QuotaApplication[]
}

model QuotaApplication {
  id            Int          @id @default(autoincrement())
  quotaCourseId Int?
  quotaCourse   QuotaCourse? @relation(fields: [quotaCourseId], references: [id], onDelete: SetNull)
  category      String       // Örn: "YKS 2027"
  courseTitle   String       // Örn: "TYT Matematik Canlı Kampı"
  track         String       // "Sayısal", "Sözel", "Eşit Ağırlık", "Yabancı Dil"
  studentName   String       // Ad Soyad
  phone         String       // Tel No
  email         String       // E-posta
  status        String       @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model AccessCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  personName  String
  packageName String
  driveUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SeoOpportunity {
  id            Int      @id @default(autoincrement())
  keyword       String   @unique
  source        String   // "GOOGLE_SEARCH_CONSOLE", "GOOGLE_AUTOCOMPLETE", "GOOGLE_TRENDS", "INTERNAL_PERFORMANCE"
  score         Float    @default(0)
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  ctr           Float    @default(0)
  position      Float    @default(0)
  trendData     String?  // JSON string
  reason        String?
  status        String   @default("NEW") // "NEW", "DRAFT_CREATED", "UPDATING_SUGGESTED", "IGNORED"
  targetDraftId Int?
  targetPostId  Int?
  discoveredAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AiBlogDraft {
  id                   Int      @id @default(autoincrement())
  opportunityId        Int?
  title                String
  slug                 String
  metaTitle            String?
  metaDescription      String?
  excerpt              String?
  targetKeyword        String
  secondaryKeywords    String?  // JSON string array
  grade                String?
  topic                String?
  content              String
  faq                  String?  // JSON string array of {question, answer}
  internalLinks        String?  // JSON string array of {anchor, url}
  verificationRequired Boolean  @default(false)
  aiProvider           String?  // "gemini" or "openrouter"
  aiModel              String?
  status               String   @default("DRAFT") // "DRAFT", "PUBLISHED", "ARCHIVED"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SeoLog {
  id                   Int      @id @default(autoincrement())
  action               String
  queriesFound         Int      @default(0)
  opportunitiesCreated Int      @default(0)
  aiProvider           String?
  usageTokens          Int?
  status               String   @default("SUCCESS") // "SUCCESS", "ERROR", "WARNING"
  details              String?
  fallbackUsed         Boolean  @default(false)
  createdAt            DateTime @default(now())
}

model SeoSettings {
  id                     Int      @id @default(1)
  autoDraftHighScores    Boolean  @default(false)
  maxOpportunitiesPerRun Int      @default(20)
  maxAutoDraftsPerRun    Int      @default(2)
  updatedAt              DateTime @updatedAt
}

model SeoPagePerformance {
  id               Int      @id @default(autoincrement())
  pageUrl          String
  query            String
  clicks           Int      @default(0)
  impressions      Int      @default(0)
  ctr              Float    @default(0)
  position         Float    @default(0)
  prevPosition     Float?   @default(0)
  positionChange   Float?   @default(0)
  impressionGrowth Float?   @default(0)
  periodDate       String   @default("CURRENT")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([pageUrl, query, periodDate])
}

model SeoPageOptimization {
  id                     Int      @id @default(autoincrement())
  pageUrl                String   @unique
  pageTitle              String?
  targetKeyword          String?
  topQuery               String?
  clicks                 Int      @default(0)
  impressions            Int      @default(0)
  ctr                    Float    @default(0)
  position               Float    @default(0)
  prevPosition           Float?   @default(0)
  positionChange         Float?   @default(0)
  optimizationScore      Float    @default(0)
  opportunityType        String   // "RISING_CONTENT", "TOP_3_OPPORTUNITY", "FIRST_PAGE_OPPORTUNITY", "RANKING_DROP", "HIGH_IMP_LOW_CTR", "CANNIBALIZATION_RISK", "CONTENT_REFRESH", "LOW_POTENTIAL"
  status                 String   @default("PENDING_ANALYSIS") // "PENDING_ANALYSIS", "ANALYZED", "APPLIED", "IGNORED"
  aiAnalysis             String?  // JSON string
  aiAnalyzedAt           DateTime?
  lastAppliedAt          DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model SeoOptimizationHistory {
  id               Int      @id @default(autoincrement())
  pageUrl          String
  actionType       String   // "TITLE_META_UPDATE", "CONTENT_EXPANDED", "INTERNAL_LINKS_ADDED", "FULL_OPTIMIZATION"
  titleBefore      String?
  titleAfter       String?
  metaDescBefore   String?
  metaDescAfter    String?
  contentChanges   String?
  posBefore        Float?
  posAfter         Float?
  ctrBefore        Float?
  ctrAfter         Float?
  dateApplied      DateTime @default(now())
  resultEvaluated  Boolean  @default(false)
  evaluationNote   String?
}

model SeoContentCluster {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  slug          String   @unique
  pillarPageUrl String?
  targetKeyword String?
  clusterType   String   @default("GRADE_TOPIC")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}




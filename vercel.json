{
  "version": 2,
  "buildCommand": "cd server && npx prisma generate && cd ../client && npm run build",
  "outputDirectory": "client/dist",
  "crons": [
    {
      "path": "/api/cron/scan",
      "schedule": "0 9 * * 1,4"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
